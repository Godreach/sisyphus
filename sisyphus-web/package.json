{
  "name": "sisyphus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm run test && npm run i18n:check"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "naive-ui": "^2.45.2",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "typescript": "~5.7.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}