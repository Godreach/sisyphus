    "/healthz": {
      "get": {
        "tags": [
          "infra"
        ],
        "summary": "存活探针：不鉴权、不查库（票 B2a-T3；Spec B2a 裁定本阶段只答进程存活）。\nADR-0019 定的深度为「进程 + SQLite `SELECT 1`」，该深度随存储消费与\n可观测性批次接入（T4 起池进组合根才有可查对象）。",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "进程存活",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Healthz"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "type": "object",
        "description": "自助改密请求体（票 B2b-T4）。",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string",
            "description": "当前密码（核验通过才允许改）。"
          },
          "new_password": {
            "type": "string",
            "description": "新密码（最小长度 8，无复杂度规则）。"
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "description": "创建项目请求体。",
        "required": [
          "name",
          "scm_type",
          "scm_url"
        ],
        "properties": {
          "default_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "git 默认分支（可空；svn 项目不适用）。"
          },
          "name": {
            "type": "string",
            "description": "项目名（唯一）。"
          },
          "scm_type": {
            "$ref": "#/components/schemas/ScmTypeDto",
            "description": "仓库类型。"
          },
          "scm_url": {
            "type": "string",
            "description": "仓库 URL。"
          }
        }
      },
      "CreateTokenRequest": {
        "type": "object",
        "description": "创建 PAT 请求体。",
        "required": [
          "name"
        ],
        "properties": {
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "过期时间（Unix 毫秒；`null` = 永不过期）。须晚于当前时间。"
          },
          "name": {
            "type": "string",
            "description": "令牌名（管理用，如 `ci-deploy`；非空，trim 后生效）。"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "description": "建号请求体（全局 admin）。",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "is_admin": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否全局管理员（默认 false——建号默认普通用户，admin 是显式选择）。"
          },
          "password": {
            "type": "string",
            "description": "密码（最小长度 8，无复杂度规则）。"
          },
          "username": {
            "type": "string",
            "description": "用户名（1-64 位字母数字或 `_ . -`，trim 后生效）。"
          }
        }
      },
      "CreatedTokenResponse": {
        "type": "object",
        "description": "创建 PAT 响应：完整令牌仅此一次返回（此后任何端点不再出现值）。",
        "required": [
          "token",
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "创建时间（Unix 毫秒）。"
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "过期时间（Unix 毫秒；`null` = 永不过期）。"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "行 id。"
          },
          "name": {
            "type": "string",
            "description": "令牌名。"
          },
          "token": {
            "type": "string",
            "description": "完整令牌（`sis_` 前缀 + 43 字符）。请立即保存：本响应是唯一一次\n出现，库里只存其 SHA-256，任何端点都无法找回。"
          }
        }
      },
      "CredentialsRequest": {
        "type": "object",
        "description": "setup wizard / login 共用的凭据请求体。",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "密码（最小长度 8，无复杂度规则）。"
          },
          "username": {
            "type": "string",
            "description": "用户名。"
          }
        }
      },
      "DirectoryEntryResponse": {
        "type": "object",
        "description": "用户目录项（最小形态：仅 id + 用户名）。",
        "required": [
          "id",
          "username"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "用户 id。"
          },
          "username": {
            "type": "string",
            "description": "用户名。"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "统一错误响应体。",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "机器可读错误码（大写蛇形，如 `NOT_FOUND`、`VALIDATION_FAILED`）。"
          },
          "detail": {
            "description": "结构化补充（如校验错误清单）；无补充时缺省不输出。"
          },
          "message": {
            "type": "string",
            "description": "人读错误信息，可直接展示。"
          }
        }
      },
      "Healthz": {
        "type": "object",
        "description": "`/healthz` 响应体。",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "固定 `ok`：仅表进程存活，不代表依赖就绪。"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "当前用户视图（setup / login / me 共用；SPA 引导用）。",
        "required": [
          "username",
          "is_admin"
        ],
        "properties": {
          "is_admin": {
            "type": "boolean",
            "description": "是否全局管理员。"
          },
          "username": {
            "type": "string",
            "description": "用户名。"
          }
        }
      },
      "MemberAssignment": {
        "type": "object",
        "description": "PUT 成员清单的条目：用户名 + 角色。",
        "required": [
          "username",
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/RoleDto",
            "description": "分配的角色。"
          },
          "username": {
            "type": "string",
            "description": "用户名（须已存在；目录端点 `GET /users/directory` 供下拉）。"
          }
        }
      },
      "MemberResponse": {
        "type": "object",
        "description": "成员清单项（GET 响应 / PUT 后回读共用）。",
        "required": [
          "user_id",
          "username",
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/RoleDto",
            "description": "项目角色。"
          },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "description": "用户 id。"
          },
          "username": {
            "type": "string",
            "description": "用户名。"
          }
        }
      },
      "PatchUserRequest": {
        "type": "object",
        "description": "禁用/启用请求体（全局 admin）。",
        "required": [
          "disabled"
        ],
        "properties": {
          "disabled": {
            "type": "boolean",
            "description": "目标状态：true = 禁用（同秒删其全部 session 与 PAT），false = 启用。"
          }
        }
      },
      "PipelineDefinitionPayload": {
        "type": "object",
        "description": "PUT 请求体：Pipeline 定义（sisyphus-model JSON 形态）。\n\nOpenAPI 契约里是自由 object——schema 事实源在 sisyphus-model，\n不在 API 层复刻一份漂移源。"
      },
      "PipelineDefinitionResponse": {
        "type": "object",
        "description": "GET 响应：当前定义 + 修订版本语义字段。",
        "required": [
          "definition",
          "revision",
          "operator",
          "updated_at"
        ],
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/PipelineDefinitionPayload",
            "description": "Pipeline 定义（model JSON 形态，与提交等价读回）。"
          },
          "operator": {
            "type": "string",
            "description": "最后保存的操作人。"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "description": "当前修订版本号（每次保存 +1，从 1 起）。",
            "minimum": 0
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "最后保存时间（Unix 毫秒）。"
          }
        }
      },
      "ProjectResponse": {
        "type": "object",
        "description": "项目视图（list / create / get 共用）。",
        "required": [
          "id",
          "name",
          "scm_type",
          "scm_url",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "创建时间（Unix 毫秒）。"
          },
          "default_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "git 默认分支（可空；svn 恒空）。"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "行 id。"
          },
          "name": {
            "type": "string",
            "description": "项目名（唯一）。"
          },
          "scm_type": {
            "$ref": "#/components/schemas/ScmTypeDto",
            "description": "仓库类型（`git` / `svn`）。"
          },
          "scm_url": {
            "type": "string",
            "description": "仓库 URL。"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "最后更新时间（Unix 毫秒）。"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "description": "代办重置密码请求体（全局 admin，无需当前密码——ADR-0014：v1 无邮件\n自助重置，管理员代办即找回通道）。",
        "required": [
          "new_password"
        ],
        "properties": {
          "new_password": {
            "type": "string",
            "description": "新密码（最小长度 8，无复杂度规则）。"
          }
        }
      },
      "RoleDto": {
        "type": "string",
        "description": "角色的 API 形态（`viewer` / `runner` / `admin`；域类型 [`Role`] 落库文本\n同形，转换零成本）。",
        "enum": [
          "viewer",
          "runner",
          "admin"
        ]
      },
      "SaveDefinitionResponse": {
        "type": "object",
        "description": "PUT 响应：保存成功，返回新修订版本。",
        "required": [
          "revision",
          "operator",
          "updated_at"
        ],
        "properties": {
          "operator": {
            "type": "string",
            "description": "操作人（登录用户名，票 B2b-T1 起）。"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "description": "本次保存后的修订版本号。",
            "minimum": 0
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "保存时间（Unix 毫秒）。"
          }
        }
      },
      "ScmTypeDto": {
        "type": "string",
        "description": "仓库类型（API 形态；`git` / `svn`）。",
        "enum": [
          "git",
          "svn"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "description": "PAT 列表项（无值形态：名 / 创建时间 / 过期——令牌值任何端点不再出现）。",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "创建时间（Unix 毫秒）。"
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "过期时间（Unix 毫秒；`null` = 永不过期）。"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "行 id（吊销端点的路径参数）。"
          },
          "name": {
            "type": "string",
            "description": "令牌名。"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "description": "用户管理视图（密码哈希永不出现；含 disabled——禁用行仍可见可管理）。",
        "required": [
          "id",
          "username",
          "is_admin",
          "disabled",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "创建时间（Unix 毫秒）。"
          },
          "disabled": {
            "type": "boolean",
            "description": "禁用标志（禁用即踢线：session 与 PAT 同秒全删）。"
          },
          "id": {
            "type": "integer",
