    "/api/v1/users/{name}": {
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "禁用 / 启用（全局 admin）。禁用同事务级联删除该用户全部 session 与\nPAT——旧 cookie 与旧令牌下一请求即 401；用户行永不删除，历史操作人\n字段不动。启用后以原密码重新登录。",
        "operationId": "patch",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "用户名",
