{
  "openapi": "3.1.0",
  "info": {
    "title": "sisyphus Server API",
    "description": "自托管 CI 平台 Server REST API。业务端点均在 /api/v1/ 前缀下；B2b 起会话认证全局把关（未认证一律 401，放行面仅 login/setup/healthz 与静态资源，票 B2b-T1）。",
    "contact": {
      "name": "sisyphus contributors"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登录：用户名密码换取会话 cookie。",
        "description": "登录限流（票 B2b-T2，ADR-0014）：per-IP（直连地址，v1 不信任\nX-Forwarded-For，反代场景写进部署文档）与 per-username 双键独立计数，\n任一键冷却中即 429；失败对双键各记一次，成功对双键清零。",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "登录成功，Set-Cookie 下发会话（HttpOnly + SameSite=Lax + Path=/）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "用户名或密码错误（不区分两者）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "请求体不是合法 JSON 或形态不符",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "登录尝试过于频繁（per-IP / per-username 连续 5 败进入冷却，随连续触发递增、封顶 15 分钟）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登出：删会话行（原 cookie 即刻失效）并清 cookie。",
        "description": "Bearer PAT 通道无会话可结束：204 无动作（PAT 的失效面是吊销端点，\n[`super::tokens::revoke`]）。",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "已登出：会话删除 + Set-Cookie 清空（需认证；Bearer PAT 通道无事可做，同 204）"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "当前用户（SPA 引导用；需认证）。",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "当前用户名与全局管理员标志",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "setup wizard：空库时创建首个全局管理员。",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "首个全局管理员已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "404": {
            "description": "用户表非空：端点不可用（不暴露状态）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（用户名非空、密码最小 8 位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/tokens": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "列出当前用户全部 PAT（按创建时间升序；无值形态）。",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "当前用户的 PAT 清单（名 / 创建时间 / 过期，永不含令牌值）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TokenResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "创建 PAT（需认证，权限 = owner 本人）。",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "已创建；token 值仅此一次返回，此后任何端点不再出现",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（名非空、过期时间须晚于当前时间）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/tokens/{id}": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "吊销 PAT（删行，下一请求即 401）。",
        "operationId": "revoke",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "PAT 行 id（列表返回的 id）",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已吊销：行已删，该令牌即刻失效"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "id 不存在或不属于当前用户（不暴露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "项目清单。",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "全部项目（按名排序）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "创建项目。",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            }
          },
          "409": {
            "description": "项目名已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（错误清单整组透传）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{name}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "按名取项目。",
        "operationId": "get_one",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "项目",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{name}/pipelines/{pipeline}": {
      "get": {
        "tags": [
          "pipelines"
        ],
        "summary": "读 pipeline 定义。",
        "operationId": "get_definition",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pipeline",
            "in": "path",
            "description": "pipeline 名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前定义与修订版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineDefinitionResponse"
                }
              }
            }
          },
          "404": {
            "description": "项目或 pipeline 不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "pipelines"
        ],
        "summary": "保存 pipeline 定义（upsert：首存 revision=1，续存 +1）。",
        "operationId": "put_definition",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pipeline",
            "in": "path",
            "description": "pipeline 名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineDefinitionPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "已保存，返回新修订版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveDefinitionResponse"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "model 校验失败，错误清单整组透传",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "infra"
        ],
        "summary": "存活探针：不鉴权、不查库（票 B2a-T3；Spec B2a 裁定本阶段只答进程存活）。\nADR-0019 定的深度为「进程 + SQLite `SELECT 1`」，该深度随存储消费与\n可观测性批次接入（T4 起池进组合根才有可查对象）。",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "进程存活",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Healthz"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "type": "object",
        "description": "创建项目请求体。",
        "required": [
          "name",
          "scm_type",
          "scm_url"
        ],
        "properties": {
          "default_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "git 默认分支（可空；svn 项目不适用）。"
          },
          "name": {
            "type": "string",
            "description": "项目名（唯一）。"
          },
          "scm_type": {
            "$ref": "#/components/schemas/ScmTypeDto",
            "description": "仓库类型。"
          },
          "scm_url": {
            "type": "string",
            "description": "仓库 URL。"
          }
        }
      },
      "CreateTokenRequest": {
        "type": "object",
        "description": "创建 PAT 请求体。",
        "required": [
          "name"
        ],
        "properties": {
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "过期时间（Unix 毫秒；`null` = 永不过期）。须晚于当前时间。"
          },
          "name": {
            "type": "string",
            "description": "令牌名（管理用，如 `ci-deploy`；非空，trim 后生效）。"
          }
        }
      },
      "CreatedTokenResponse": {
        "type": "object",
        "description": "创建 PAT 响应：完整令牌仅此一次返回（此后任何端点不再出现值）。",
        "required": [
          "token",
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "创建时间（Unix 毫秒）。"
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "过期时间（Unix 毫秒；`null` = 永不过期）。"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "行 id。"
          },
          "name": {
            "type": "string",
            "description": "令牌名。"
          },
          "token": {
            "type": "string",
            "description": "完整令牌（`sis_` 前缀 + 43 字符）。请立即保存：本响应是唯一一次\n出现，库里只存其 SHA-256，任何端点都无法找回。"
          }
        }
      },
      "CredentialsRequest": {
        "type": "object",
        "description": "setup wizard / login 共用的凭据请求体。",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "密码（最小长度 8，无复杂度规则）。"
          },
          "username": {
            "type": "string",
            "description": "用户名。"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "统一错误响应体。",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "机器可读错误码（大写蛇形，如 `NOT_FOUND`、`VALIDATION_FAILED`）。"
          },
          "detail": {
            "description": "结构化补充（如校验错误清单）；无补充时缺省不输出。"
          },
          "message": {
            "type": "string",
            "description": "人读错误信息，可直接展示。"
          }
        }
      },
      "Healthz": {
        "type": "object",
        "description": "`/healthz` 响应体。",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "固定 `ok`：仅表进程存活，不代表依赖就绪。"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "当前用户视图（setup / login / me 共用；SPA 引导用）。",
        "required": [
          "username",
          "is_admin"
        ],
        "properties": {
          "is_admin": {
            "type": "boolean",
            "description": "是否全局管理员。"
          },
          "username": {
            "type": "string",
            "description": "用户名。"
          }
        }
      },
      "PipelineDefinitionPayload": {
        "type": "object",
        "description": "PUT 请求体：Pipeline 定义（sisyphus-model JSON 形态）。\n\nOpenAPI 契约里是自由 object——schema 事实源在 sisyphus-model，\n不在 API 层复刻一份漂移源。"
      },
      "PipelineDefinitionResponse": {
        "type": "object",
        "description": "GET 响应：当前定义 + 修订版本语义字段。",
        "required": [
          "definition",
          "revision",
          "operator",
          "updated_at"
        ],
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/PipelineDefinitionPayload",
            "description": "Pipeline 定义（model JSON 形态，与提交等价读回）。"
          },
          "operator": {
            "type": "string",
            "description": "最后保存的操作人。"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "description": "当前修订版本号（每次保存 +1，从 1 起）。",
            "minimum": 0
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "最后保存时间（Unix 毫秒）。"
          }
        }
      },
      "ProjectResponse": {
        "type": "object",
        "description": "项目视图（list / create / get 共用）。",
        "required": [
          "id",
          "name",
          "scm_type",
          "scm_url",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "创建时间（Unix 毫秒）。"
          },
          "default_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "git 默认分支（可空；svn 恒空）。"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "行 id。"
          },
          "name": {
            "type": "string",
            "description": "项目名（唯一）。"
          },
          "scm_type": {
            "$ref": "#/components/schemas/ScmTypeDto",
            "description": "仓库类型（`git` / `svn`）。"
          },
          "scm_url": {
            "type": "string",
            "description": "仓库 URL。"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "最后更新时间（Unix 毫秒）。"
          }
        }
      },
      "SaveDefinitionResponse": {
        "type": "object",
        "description": "PUT 响应：保存成功，返回新修订版本。",
        "required": [
          "revision",
          "operator",
          "updated_at"
        ],
        "properties": {
          "operator": {
            "type": "string",
            "description": "操作人（登录用户名，票 B2b-T1 起）。"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "description": "本次保存后的修订版本号。",
            "minimum": 0
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "保存时间（Unix 毫秒）。"
          }
        }
      },
      "ScmTypeDto": {
        "type": "string",
        "description": "仓库类型（API 形态；`git` / `svn`）。",
        "enum": [
          "git",
          "svn"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "description": "PAT 列表项（无值形态：名 / 创建时间 / 过期——令牌值任何端点不再出现）。",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
