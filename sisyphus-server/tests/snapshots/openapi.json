{
  "openapi": "3.1.0",
  "info": {
    "title": "sisyphus Server API",
    "description": "自托管 CI 平台 Server REST API。业务端点均在 /api/v1/ 前缀下；B2b 起会话认证全局把关（未认证一律 401，放行面仅 login/setup/healthz 与静态资源，票 B2b-T1）。",
    "contact": {
      "name": "sisyphus contributors"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登录：用户名密码换取会话 cookie。",
        "description": "登录限流（票 B2b-T2，ADR-0014）：per-IP（直连地址，v1 不信任\nX-Forwarded-For，反代场景写进部署文档）与 per-username 双键独立计数，\n任一键冷却中即 429；失败对双键各记一次，成功对双键清零。",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "登录成功，Set-Cookie 下发会话（HttpOnly + SameSite=Lax + Path=/）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "用户名或密码错误（不区分两者）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "请求体不是合法 JSON 或形态不符",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "登录尝试过于频繁（per-IP / per-username 连续 5 败进入冷却，随连续触发递增、封顶 15 分钟）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登出：删会话行（原 cookie 即刻失效）并清 cookie。",
        "description": "Bearer PAT 通道无会话可结束：204 无动作（PAT 的失效面是吊销端点，\n[`super::tokens::revoke`]）。",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "已登出：会话删除 + Set-Cookie 清空（需认证；Bearer PAT 通道无事可做，同 204）"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "当前用户（SPA 引导用；需认证）。",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "当前用户名与全局管理员标志",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "自助改密（票 B2b-T4，ADR-0014）：需验当前密码，验错 403 拒绝——不经\n管理员即可轮换自己的凭据。只换哈希：既有会话与 PAT 不受牵连（各自有\n独立失效途径：登出 / 吊销），管理员代办重置在 [`super::users::reset_password`]。",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "已改密：新密码下次登录生效，既有会话/PAT 不受牵连"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "当前密码不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（新密码最小 8 位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "自注册（票 B2b-T4，ADR-0014）：注册开关（config `[auth]\nregistration_enabled`，默认关）打开时自建**非管理员**账号；关闭时一律\n403（内网由全局 admin 建号）。空库时同样 403——首个账号必须经 setup\nwizard 成为全局 admin，否则自注册出普通用户后 setup 永久 404、实例\n再无管理员入口。成功响应不带会话（与 setup 同形：登录是独立一步）。",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "非管理员账号已创建（不带会话，登录是独立一步）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "403": {
            "description": "注册开关未开启，或用户表为空（先走 setup wizard）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "用户名已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（用户名非空/字符集、密码最小 8 位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "setup wizard：空库时创建首个全局管理员。",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "首个全局管理员已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "404": {
            "description": "用户表非空：端点不可用（不暴露状态）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（用户名非空/字符集、密码最小 8 位）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/tokens": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "列出当前用户全部 PAT（按创建时间升序；无值形态）。",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "当前用户的 PAT 清单（名 / 创建时间 / 过期，永不含令牌值）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TokenResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "创建 PAT（需认证，权限 = owner 本人）。",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "已创建；token 值仅此一次返回，此后任何端点不再出现",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（名非空、过期时间须晚于当前时间）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/tokens/{id}": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "吊销 PAT（删行，下一请求即 401）。",
        "operationId": "revoke",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "PAT 行 id（列表返回的 id）",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已吊销：行已删，该令牌即刻失效"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "id 不存在或不属于当前用户（不暴露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "项目清单（按可见性过滤：全局 admin 全量、普通用户只列有角色的项目，\n票 B2b-T5）。",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "调用者可见的项目（全局 admin 全量、普通用户仅有角色的项目；按名排序）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "创建项目（全局管理员专属，票 B2b-T5：全局资源只认 `is_admin`）。",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "非全局管理员（建项目为全局资源）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "项目名已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（错误清单整组透传）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{name}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "按名取项目（viewer 档声明：无角色与不存在同形 404，票 B2b-T5）。",
        "operationId": "get_one",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "项目",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在或对调用者不可见（不泄露存在性）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{name}/members": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "查看项目成员（项目 admin 档；全局 admin 的隐含成员关系不在此列，\nADR-0014：避免噪声，仍可显式分配以显式化）。",
        "operationId": "list",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成员清单（按用户名排序）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "项目权限不足（成员管理需项目 admin 档）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在或不可见",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "projects"
        ],
        "summary": "整组分配项目成员（PUT 语义：提交清单即完整状态，未列入者移除；\n角色变更即时生效）。",
        "operationId": "replace",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MemberAssignment"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "已分配，返回落定后的成员清单",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "项目权限不足（成员管理需项目 admin 档）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "项目不存在或不可见",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "输入校验失败（用户名空白 / 重复 / 不存在）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{name}/pipelines/{pipeline}": {
      "get": {
        "tags": [
          "pipelines"
        ],
        "summary": "读 pipeline 定义（viewer 档：无角色与项目不存在同形 404，票 B2b-T5）。",
        "operationId": "get_definition",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pipeline",
            "in": "path",
            "description": "pipeline 名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前定义与修订版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineDefinitionResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "项目或 pipeline 不存在（或项目不可见）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "pipelines"
        ],
        "summary": "保存 pipeline 定义（项目 admin 档，票 B2b-T5；upsert：首存 revision=1，\n续存 +1；操作人为认证用户实名，票 B2b-T1）。",
        "operationId": "put_definition",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "项目名",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pipeline",
            "in": "path",
            "description": "pipeline 名",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineDefinitionPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "已保存，返回新修订版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveDefinitionResponse"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "项目权限不足（保存定义需项目 admin 档）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
